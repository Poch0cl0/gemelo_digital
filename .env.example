# Copia este archivo a .env y rellena tu clave (no subas .env a git).
AGENT_PROVIDER=gemini
GEMINI_API_KEY=tu-clave-aqui
GEMINI_MODEL=gemini-2.0-flash

# Alternativa DeepSeek:
# AGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-tu-clave-aqui
# DEEPSEEK_MODEL=deepseek-chat

# Alternativa local:
# AGENT_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://127.0.0.1:11434

# LangFlow (opcional, sub-agente narrativo; requiere servicio aparte en puerto 7860):
# LANGFLOW_URL=http://127.0.0.1:7860
# LANGFLOW_FLOW_ID=tu-flow-id-aqui
# LANGFLOW_API_KEY=tu-api-key-langflow
# LANGFLOW_TIMEOUT=60
#
# Instalar LangFlow en un venv separado (evita conflictos con langchain-core del agente):
#   python -m venv .venv-langflow
#   .venv-langflow\Scripts\pip install langflow
#   .venv-langflow\Scripts\langflow run
